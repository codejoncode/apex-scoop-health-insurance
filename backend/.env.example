# Database
DATABASE_URL=postgresql://user:password@localhost:5432/apex_scoop_db

# JWT
JWT_SECRET=your-secret-key-change-in-production

# Email (SendGrid or similar)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
